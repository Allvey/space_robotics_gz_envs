<?xml version="1.0"?>
<sdf version="1.9">
  <world name="mining_vehicles">
    <physics name="mining_physics" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -1.622</gravity>
    <scene>
      <ambient>0.5 0.5 0.52 1</ambient>
      <background>0.08 0.10 0.14 1</background>
      <shadows>true</shadows>
    </scene>
    <gui>
      <plugin filename="MinimalScene" name="3D View">
        <engine>ogre2</engine>
        <camera_pose>-4.6 -6 3.5 0 0.4 0.95</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <play_pause>true</play_pause><step>true</step><start_paused>true</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats"/>
      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="TransformControl" name="Transform control"/>
      <plugin filename="Teleop" name="Teleoperation"/>
    </gui>
    <light type="directional" name="sun">
      <pose>-3 -4 6 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse><specular>0.3 0.3 0.3 1</specular>
      <direction>0.4 0.5 -1</direction><cast_shadows>true</cast_shadows>
      <visualize>false</visualize>
    </light>
    <light type="directional" name="inspection_fill">
      <pose>3 2 4 0 0 0</pose>
      <diffuse>0.45 0.48 0.55 1</diffuse><specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 -0.4 -0.8</direction><cast_shadows>false</cast_shadows>
      <visualize>false</visualize>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.25 0.27 0.30 1</ambient><diffuse>0.35 0.37 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include><uri>model://lunar_excavator</uri><name>lunar_excavator</name><pose>0 -0.85 0.43 0 0 0</pose></include>
    <include><uri>model://lunar_hauler</uri><name>lunar_hauler</name><pose>0.25 0.85 0.43 0 0 0</pose></include>
  </world>
</sdf>
